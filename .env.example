# ImageKit — entrega y subida de imagenes (igual que el sitio de referencia)
# Consiguelos en https://imagekit.io -> Developer options
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/tu_id"
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_xxxxxxxxxxxxxxxxxxxx"
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxxxxxxxxxxxxx"

# Panel de administracion — credencial simple para el scaffold.
# Sustituir por autenticacion real (NextAuth/Clerk) antes de produccion.
ADMIN_PASSWORD="cambia-esta-clave"

